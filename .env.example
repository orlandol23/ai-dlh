# ========================================
# API KEYS
# ========================================

# Google Gemini API (grátis 1500 req/dia)
# Obter: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ========================================
# DATABASE
# ========================================

# Vercel Postgres (free tier)
# Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:pass@host.vercel-storage.com:5432/db

# ========================================
# BLOCKCHAIN (ETHEREUM SEPOLIA)
# ========================================

# RPC URL (Infura ou Alchemy)
# Infura: https://infura.io
# Alchemy: https://www.alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private Key wallet backend (NUNCA commitar!)
# Gerar com: npm run generate:wallet
PRIVATE_KEY=0x...

# Contract address (após deploy)
CONTRACT_ADDRESS=0x...

# Etherscan API (verificação)
# Obter: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_KEY

# ========================================
# AUTHENTICATION
# ========================================

# JWT Secret (gerar: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# ========================================
# APPLICATION
# ========================================

NODE_ENV=development
PORT=3000

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Backend API URL (usado pelo frontend)
VITE_API_URL=http://localhost:3000/trpc

# ========================================
# VERCEL (Production)
# ========================================

# Estas serão configuradas automaticamente pelo Vercel
# VERCEL_URL
# VERCEL_ENV
