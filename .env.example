# ========================================
# API KEYS
# ========================================

# Google Gemini API (free tier: 250 requests/day per project; beyond that, paid)
# Get one: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Anthropic Claude API (optional — enables tier="premium" in PreferencesPanel)
# Get one: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Alibaba Cloud DashScope (optional — enables region="cn" via header x-region: cn)
# Get one: https://dashscope.console.aliyun.com
# DASHSCOPE_API_KEY=sk-...

# ========================================
# DATABASE
# ========================================

# Vercel Postgres (free tier)
# Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:pass@host.vercel-storage.com:5432/db

# ========================================
# BLOCKCHAIN (ETHEREUM SEPOLIA)
# ========================================

# RPC URL (Infura or Alchemy)
# Infura: https://infura.io
# Alchemy: https://www.alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Backend wallet private key (NEVER commit this!)
# Generate with: npm run generate:wallet
PRIVATE_KEY=0x...

# Contract address (after deploy)
CONTRACT_ADDRESS=0x...

# Etherscan API (verification)
# Get one: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_KEY

# ========================================
# AUTHENTICATION
# ========================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# ========================================
# APPLICATION
# ========================================

NODE_ENV=development
PORT=3000

# Frontend URL (for CORS and the Web3 auth domain-binding).
# In production, set it to the real URL (e.g. https://app.example.com).
FRONTEND_URL=http://localhost:5173

# CORS - additional list of allowed origins, comma-separated.
# E.g.: "https://admin.example.com,https://staging.example.com"
ALLOWED_ORIGINS=

# CORS - accepted host suffixes for preview deploys (comma-separated).
# Each suffix MUST start with "-" or "." to guarantee the match happens
# on a label boundary (without that, "example.com" would also accept
# "evil-example.com"). Broad platform-wide suffixes like "vercel.app"
# are rejected at boot.
# E.g.: "-myuser.vercel.app" opens up only your own Vercel previews.
# Leave empty to disable suffix matching entirely.
ALLOWED_ORIGIN_SUFFIXES=

# Maximum window (ms) between the signed message's Timestamp and receipt on
# the backend. Below this value the message is accepted; above it, rejected.
AUTH_MESSAGE_MAX_AGE_MS=300000

# ========================================
# RATE LIMITING
# ========================================

# Global per-IP limit in Express (generous — only blocks abuse, not real
# users). Health checks (/healthz, /health) are exempt.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# Per-user limits (1h sliding window, in memory) for the expensive
# procedures: module generation spends Gemini API quota, and an approved
# quiz submission spends ETH from the server's custodial wallet.
RATE_LIMIT_AI_GENERATE_PER_HOUR=10
RATE_LIMIT_QUIZ_SUBMIT_PER_HOUR=30

# progress.retryBlockchain (the "try again" button on a failed_permanent
# record) — each retry can spend ETH, so the limit is tight.
RATE_LIMIT_BLOCKCHAIN_RETRY_PER_HOUR=10

# ========================================
# ON-CHAIN QUEUE (async worker)
# ========================================

# BASE interval (ms) between polls of the worker that writes completions
# to the blockchain. This is the fast cadence, used while there is work
# in the queue.
BLOCKCHAIN_QUEUE_INTERVAL_MS=15000

# Safety-net poll (ms) while the queue is idle. New work never waits for
# it — submitQuiz/retryBlockchain wake the worker immediately via wake()
# — so this only bounds how long a record inserted outside the process
# (manual SQL, a second instance) would go unnoticed.
#
# Sized for serverless Postgres billing: Neon (and equivalents) bill
# compute by time-awake and EACH wakeup costs at least the full suspend
# window (~5 min on the Free plan). The idle cost is proportional to the
# NUMBER of polls, not their weight: the previous 30-min ceiling still
# woke the database 48x/day ≈ 4h of billed compute per idle day — that
# alone exhausts a 100 CU-hour monthly allowance. At 6h the idle floor is
# 4 wakeups/day (~20 min billed). Must be >= BLOCKCHAIN_QUEUE_INTERVAL_MS.
BLOCKCHAIN_QUEUE_MAX_INTERVAL_MS=21600000

# Maximum send attempts before marking the record as failed_permanent
# (exponential backoff: 1min, 5min, 30min, 30min...).
BLOCKCHAIN_QUEUE_MAX_ATTEMPTS=5

# Time (ms) waiting for 1 confirmation before resending the same tx with
# a 25% fee bump (replace-by-fee, same nonce).
BLOCKCHAIN_TX_TIMEOUT_MS=90000

# Records stuck in 'processing' for longer than this (ms) are considered
# orphaned (server crash mid-send) and become eligible again.
BLOCKCHAIN_STALE_LOCK_MS=600000

# ========================================
# CUSTODIAL WALLET BALANCE MONITOR
# ========================================

# Below this balance (in ETH) the server logs a structured warning and
# /healthz starts reporting walletBalanceLow=true. Default sized for
# Sepolia: ~50 simple writes of headroom.
WALLET_LOW_BALANCE_THRESHOLD_ETH=0.05

# Interval (ms) between periodic checks of the custodial wallet balance.
WALLET_BALANCE_CHECK_INTERVAL_MS=300000

# Skip drizzle migrate() on server boot. Useful when migrations are
# applied by a separate release-phase job. Any value other than "true"
# keeps migrations enabled (typo fail-closed).
SKIP_MIGRATIONS=false

# Backend API URL (used by the frontend)
VITE_API_URL=http://localhost:3000/trpc

# ========================================
# OBSERVABILITY — SENTRY (optional)
# ========================================
# The 3 variables below are OPTIONAL. Without them, Sentry is a silent
# no-op in both workspaces — dev/test/CI stay identical to before.
# Setup: create 2 projects on the free tier of https://sentry.io (one
# Node project for the server, one React project for the frontend) and
# copy each one's DSN.

# DSN for the Node project (Express+tRPC server). Enables capture of
# unhandled Express errors, tRPC procedures (INTERNAL_SERVER_ERROR), the
# blockchain queue and the balance monitor. Auth/cookie headers are
# stripped from every event (beforeSend); PRIVATE_KEY/JWT are never sent.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# DSN for the React project (frontend). This is a public ingestion key —
# it appears in the bundle by design, it is not a secret.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Release + sourcemap upload during the frontend build (Vercel/CI).
# Without the token, the build runs normally and simply skips uploading
# sourcemaps — CI never fails for lack of this secret. Also requires
# SENTRY_ORG and SENTRY_PROJECT (the org/project slugs on sentry.io).
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=my-org
# SENTRY_PROJECT=ai-dlh

# ========================================
# VERCEL (Production)
# ========================================

# These are configured automatically by Vercel
# VERCEL_URL
# VERCEL_ENV
