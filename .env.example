# ========================================
# API KEYS
# ========================================

# Google Gemini API (grátis 1500 req/dia)
# Obter: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Anthropic Claude API (opcional — habilita tier="premium" no PreferencesPanel)
# Obter: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Alibaba Cloud DashScope (opcional — habilita region="cn" via header x-region: cn)
# Obter: https://dashscope.console.aliyun.com
# DASHSCOPE_API_KEY=sk-...

# ========================================
# DATABASE
# ========================================

# Vercel Postgres (free tier)
# Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:pass@host.vercel-storage.com:5432/db

# ========================================
# BLOCKCHAIN (ETHEREUM SEPOLIA)
# ========================================

# RPC URL (Infura ou Alchemy)
# Infura: https://infura.io
# Alchemy: https://www.alchemy.com
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private Key wallet backend (NUNCA commitar!)
# Gerar com: npm run generate:wallet
PRIVATE_KEY=0x...

# Contract address (após deploy)
CONTRACT_ADDRESS=0x...

# Etherscan API (verificação)
# Obter: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_KEY

# ========================================
# AUTHENTICATION
# ========================================

# JWT Secret (gerar: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Token expiration (default: 7 days)
JWT_EXPIRES_IN=7d

# ========================================
# APPLICATION
# ========================================

NODE_ENV=development
PORT=3000

# Frontend URL (para CORS e domain-binding da autenticação Web3).
# Em produção, defina para a URL real (ex: https://app.example.com).
FRONTEND_URL=http://localhost:5173

# CORS - lista adicional de origens permitidas, separadas por vírgula.
# Ex: "https://admin.example.com,https://staging.example.com"
ALLOWED_ORIGINS=

# CORS - sufixos de host aceitos para previews (separados por vírgula).
# Cada sufixo PRECISA começar com "-" ou "." para garantir que o match
# acontece em um boundary de label (sem isso, "example.com" também
# aceitaria "evil-example.com"). Sufixos amplos de plataforma como
# "vercel.app" são rejeitados no boot.
# Ex: "-meuuser.vercel.app" libera apenas seus próprios previews da Vercel.
# Deixe vazio para desabilitar completamente o matching por sufixo.
ALLOWED_ORIGIN_SUFFIXES=

# Janela máxima (ms) entre Timestamp da mensagem assinada e recebimento no
# backend. Abaixo desse valor a mensagem é aceita; acima, é rejeitada.
AUTH_MESSAGE_MAX_AGE_MS=300000

# ========================================
# RATE LIMITING
# ========================================

# Limite global por IP no Express (generoso — só barra abuso, não usuários
# reais). Health checks (/healthz, /health) são isentos.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# Limites por usuário (janela deslizante de 1h, em memória) para as
# procedures caras: geração de módulo gasta quota da API Gemini e a
# submissão de quiz aprovada gasta ETH da wallet custodial do servidor.
RATE_LIMIT_AI_GENERATE_PER_HOUR=10
RATE_LIMIT_QUIZ_SUBMIT_PER_HOUR=30

# progress.retryBlockchain (botão "tentar novamente" de um registro
# failed_permanent) — cada retry pode gastar ETH, então o limite é apertado.
RATE_LIMIT_BLOCKCHAIN_RETRY_PER_HOUR=10

# ========================================
# FILA ON-CHAIN (worker assíncrono)
# ========================================

# Intervalo BASE (ms) entre polls do worker que grava conclusões na blockchain.
# É a cadência rápida, usada enquanto há trabalho na fila.
BLOCKCHAIN_QUEUE_INTERVAL_MS=15000

# Poll de segurança (ms) enquanto a fila está ociosa. Trabalho novo nunca
# espera por ele — submitQuiz/retryBlockchain acordam o worker na hora via
# wake() — então isto só limita quanto tempo um registro inserido por fora
# do processo (SQL manual, segunda instância) ficaria sem ser notado.
#
# Dimensionado pela cobrança de Postgres serverless: o Neon (e equivalentes)
# cobra por tempo acordado e CADA despertar custa no mínimo a janela de
# suspensão inteira (~5 min no plano Free). O custo ocioso é proporcional ao
# NÚMERO de polls, não ao peso deles: o teto anterior de 30 min ainda
# acordava o banco 48×/dia ≈ 4h de compute cobrado por dia parado — sozinho
# isso estoura uma franquia mensal de 100 CU-hora. Em 6h o piso ocioso são
# 4 despertares/dia (~20 min cobrados). Precisa ser >= BLOCKCHAIN_QUEUE_INTERVAL_MS.
BLOCKCHAIN_QUEUE_MAX_INTERVAL_MS=21600000

# Máximo de tentativas de envio antes de marcar o registro como
# failed_permanent (backoff exponencial: 1min, 5min, 30min, 30min…).
BLOCKCHAIN_QUEUE_MAX_ATTEMPTS=5

# Tempo (ms) aguardando 1 confirmação antes de reenviar a mesma tx com
# fee bump de 25% (replace-by-fee, mesmo nonce).
BLOCKCHAIN_TX_TIMEOUT_MS=90000

# Registros presos em 'processing' há mais que isso (ms) são considerados
# órfãos (crash do server no meio do envio) e voltam a ser elegíveis.
BLOCKCHAIN_STALE_LOCK_MS=600000

# ========================================
# MONITOR DE SALDO DA WALLET CUSTODIAL
# ========================================

# Abaixo deste saldo (em ETH) o servidor loga um warning estruturado e o
# /healthz passa a reportar walletBalanceLow=true. Default dimensionado
# para Sepolia: ~50 gravações simples de folga.
WALLET_LOW_BALANCE_THRESHOLD_ETH=0.05

# Intervalo (ms) entre checagens periódicas do saldo da wallet custodial.
WALLET_BALANCE_CHECK_INTERVAL_MS=300000

# Pular drizzle migrate() no boot do servidor. Útil quando migrations
# são aplicadas por um job separado de release-phase. Qualquer valor
# diferente de "true" mantém migrations habilitadas (typo fail-closed).
SKIP_MIGRATIONS=false

# Backend API URL (usado pelo frontend)
VITE_API_URL=http://localhost:3000/trpc

# ========================================
# OBSERVABILIDADE — SENTRY (opcional)
# ========================================
# As 3 variáveis abaixo são OPCIONAIS. Sem elas, o Sentry é um no-op
# silencioso nos dois workspaces — dev/test/CI ficam idênticos a antes.
# Setup: criar 2 projetos no free tier de https://sentry.io (um Node para
# o server, um React para o frontend) e copiar o DSN de cada um.

# DSN do projeto Node (server Express+tRPC). Ativa captura de erros não
# tratados do Express, procedures tRPC (INTERNAL_SERVER_ERROR), fila
# blockchain e monitor de saldo. Headers de auth/cookies são removidos
# de todo evento (beforeSend); PRIVATE_KEY/JWT nunca são enviados.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# DSN do projeto React (frontend). É uma chave pública de ingestão —
# aparece no bundle por design, não é secret.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Upload de release + sourcemaps no build do frontend (Vercel/CI).
# Sem o token, o build roda normal e apenas não sobe sourcemaps —
# a CI nunca quebra por falta deste secret. Requer também SENTRY_ORG
# e SENTRY_PROJECT (slugs da org/projeto no sentry.io).
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=minha-org
# SENTRY_PROJECT=ai-dlh

# ========================================
# VERCEL (Production)
# ========================================

# Estas serão configuradas automaticamente pelo Vercel
# VERCEL_URL
# VERCEL_ENV
