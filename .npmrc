# drizzle-orm >=0.36 declares expo-sqlite as an OPTIONAL peer, which drags
# expo -> react-native -> react@19 into npm's peer resolution. That collides
# with the frontend workspace's react@18, so npm 10 resolves the conflict by
# nesting drizzle-orm in server/node_modules instead of hoisting it. drizzle-kit
# still hoists to the root, and it locates the ORM with a bare ESM
# `import('drizzle-orm/version')` resolved from its own directory — which then
# finds nothing, breaking `npm run db:generate` / `db:push` / `db:studio` with
# "Please install latest version of drizzle-orm".
#
# Relaxing peer resolution lets drizzle-orm hoist to the root alongside
# drizzle-kit, which fixes the CLI. npm never auto-installs peers here, so
# nothing else in the tree depends on the strict behaviour. Revisit (and drop
# this file) once the frontend moves to react@19.
legacy-peer-deps=true
